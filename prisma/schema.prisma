generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Manager
  User
}

enum OrderStatus {
  Pending
  Processing
  Completed
}

model Workspace {
  id        Int       @id @default(autoincrement())
  name      String
  users     User[]
  products  Product[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  role               UserRole
  passwordHash       String?
  emailNotifications Boolean   @default(true)
  workspaceId        Int
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId])
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  stock       Int
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Order {
  id          Int         @id @default(autoincrement())
  customer    String
  total       Float
  status      OrderStatus
  workspaceId Int
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId])
}